# SkillPulse Platform Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# Leave blank to use built-in resilient in-memory database mode
MONGODB_URI=mongodb://localhost:27017/skillpulse

# Authentication JWT Secret
JWT_SECRET=skillpulse_secret_jwt_key_2026_dev_secure
JWT_EXPIRES_IN=7d

# Optional AI API Key (Google Gemini or OpenAI)
# If left blank, the platform automatically utilizes the rule-based intelligent fallback generator
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
